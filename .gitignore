htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Pyre type checker
.pyre/

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# VS Code / IDEs
.vscode/
.idea/

# ==========================================
# 🛡️ AI/ML SPECIFIC SAFEST GUARDS (NO BLOAT)
# ==========================================

# Exclude Heavy Models & PyTorch Weights
*.pt
*.pth
*.ckpt
*.h5
*.bin
checkpoints/
sam-hq/
sam-hq2/

# Exclude Large Datasets / Zip Archives
*.zip
*.rar
*.7z
DataVip/
DataVip4Goc.zip
DataVip.zip

# Exclude Debug Logs & High-Res Artifact Images
debug_top10_bbox.png
*.log
*.png
!nikeleft.png
!nikeright.png

# Exclude massive RAW CAD vector files (if they are just local references)
# Keep the core Nike templates
*.dxf
!nikeleft.dxf
!nikeright.dxf
